[run]
source = backend, ai_hub
branch = True
omit =
    backend/tests/*
    ai_hub/tests/*
    */test_*.py
    */__init__.py

[report]
# 4.6.0-F6-1（46-a）：覆盖率门禁低阈值起步，「只许升不许降」。
# 阈值单一来源为 tests/coverage_thresholds.json（后端阈值 backend.fail_under），
# CI 以 `--cov-fail-under=$(...json...)` 注入；本处为本地兜底值，二者必须一致（Q-1 断言）。
fail_under = 55
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
show_missing = True
