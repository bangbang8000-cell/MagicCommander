# 参数网 Leaf（X400 / UXOS / SONiC 基准，400G breakout 1:2 → 200G GPU，待现网校准）
# hostname {{hostname}}
#
# SONiC/UXOS 基准 —— 全局（PFC/CNP 队列可调，默认 PFC=3 / CNP=6，见 parameter.xlsx）
# PFC 无损队列与 WRED 阈值待现网校准；上联/下联端口明细（uplink/gpu 端口表）待补充
#
# 环回（/32）与带内管理
ip address add {{info['环回IP']}}/{{info['环回长度']}} dev Loopback0
ip address add {{info['管理IP']}}/24 dev Management0
#
# GPU 下联 / 上联端口明细待现网参数补充（breakout 1:2 → 200G）
#
router bgp {{info['BGP AS']}}
 bgp router-id {{info['环回IP']}}
 maximum-paths {{info['BGP多路径']}}
 address-family ipv4 unicast
  network {{info['环回IP']}}/32
 exit-address-family
 address-family l2vpn evpn
 exit-address-family
#
